<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">

    <property name="LOG_FILE_EVENT" value="logs/event.log"/>

    <property name="PATTERN_1"
              value="%date{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %-30logger{1} --- %message%n"/>
    <property name="PATTERN_2"
              value="%date{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %-30logger{1} --- %replace(%message){'\n', '⏎'}%n"/>
    <property name="PATTERN_3"
              value="%date{yyyy-MM-dd HH:mm:ss}\t%msg%n"/>
    <property name="PATTERN_4"
              value="%msg%n"/>


    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>${PATTERN_2}</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="STDOUT"/>
        <queueSize>1000</queueSize>
    </appender>

    <appender name="FILE_EVENT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <encoder>
            <pattern>${PATTERN_4}</pattern>
        </encoder>
        <file>${LOG_FILE_EVENT}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE_EVENT}.%d{yyyy-MM-dd}</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE_INFO"/>
    </root>

    <logger name="io.zw.game.api.logs.EventLogger" level="DEBUG" additivity="false">
        <appender-ref ref="FILE_EVENT"/>
    </logger>

</configuration>
