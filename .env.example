# Copy to .env for docker compose. Local development values only.
DB_URL=jdbc:postgresql://postgres:5432/auth?useSSL=false&serverTimezone=UTC
DB_USERNAME=postgres
DB_PASSWORD=postgres
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_DATABASE=1

# host ports
AUTH_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT_EXT=6379
